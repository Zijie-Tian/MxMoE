# MxMoE machine-local config. Copy to `.env` (gitignored) and edit for this node.
# Format: KEY=VALUE, one per line. Blank lines and full-line comments (#) are ignored.
# Values may use ~ (expanded at load). Process environment variables override .env.
# There are NO built-in defaults: an unconfigured model id raises a helpful error.
# Verify before running anything that loads model weights:
#   python project_config.py --check <model_id>

MXMOE_MODEL_DS2=/abs/path/to/DeepSeek-V2-Lite
MXMOE_MODEL_MIXTRAL=/abs/path/to/Mixtral-8x7B-Instruct-v0.1
MXMOE_MODEL_QWEN2_MOE=/abs/path/to/Qwen1.5-MoE-A2.7B
MXMOE_MODEL_QWEN2_MOE_57B=/abs/path/to/Qwen2-57B-A14B-Instruct
